# Rootless installation: ~/.config/containers/systemd/lucoa.container
# See README.md before starting; do not run alongside another lucoa deployment.
[Unit]
Description=lucoa Ovis coding-agent server

[Container]
Image=ghcr.io/lutvzn/lucoa:latest
Pull=missing
ContainerName=lucoa
EnvironmentFile=%h/.config/lucoa/lucoa.env
# All host IPv4 interfaces by default. Edit these bindings and configure the
# host firewall to control access; interface binding is not a source allowlist.
PublishPort=0.0.0.0:7317:7317
# Key-only SSH as node; provision authorized_keys before connecting.
PublishPort=0.0.0.0:2222:2222
Volume=lucoa-home:/home/node
Volume=lucoa-workspace:/workspace
RunInit=true
DropCapability=all
NoNewPrivileges=true
StopTimeout=20

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
