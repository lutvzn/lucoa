# Copy to .env and protect it with chmod 600. Never commit the real file.
# Browser binding; restrict this address if needed. Key-only SSH publishes on 0.0.0.0:2222.
# SSH is enabled by default. Provision /home/node/.ssh/authorized_keys; see README.md.
# Set to 0 to disable SSH (Compose and direct-run environment files).
LUCOA_SSH_ENABLED=1
LUCOA_BIND_IP=0.0.0.0
# Optional public-key text (single line here). Never put a private key here.
# LUCOA_SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... desktop
# Optional Compose image override, for example an immutable sha-<full-commit-sha> tag.
# LUCOA_IMAGE=ghcr.io/lutvzn/lucoa:latest
# Required: generate a random token; do not use this placeholder.
OVIS_TOKEN=
